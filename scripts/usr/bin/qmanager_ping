#!/bin/sh
# =============================================================================
# qmanager_ping — QManager Unified Ping Daemon
# =============================================================================
# The SINGLE source of internet reachability and latency data. Every consumer
# (poller, watchcat, frontend via status.json) reads this daemon's output. It
# never touches the modem serial port.
#
# Probing is ICMP (BusyBox ping), never HTTP and never a hostname leg of its own.
# Four legs, all IP literals except a user-set hostname primary:
#   P4 = target_ipv4 (default 1.1.1.1)
#   S4 = the other provider's IPv4 (8.8.8.8; 1.1.1.1 when P4 is already Google)
#   P6 = target_ipv6 (default 2606:4700:4700::1111)
#   S6 = the other provider's IPv6 (2001:4860:4860::8888, or Cloudflare's when
#        P6 is already Google)
#
# Cycle: P4 alone (`ping -c1 -W2 -w3`, a hard 3 s deadline; a hostname P4 gets
# `timeout 4` instead because -w does not cover the lookup). A healthy cycle sends
# one probe. When P4 fails, S4, P6 and S6 run IN PARALLEL (the IPv6 legs only when
# the kernel has an IPv6 default route), and the winner is the first leg in the
# fixed priority S4 > P6 > S6 that answered, so the reported RTT is deterministic.
# Worst case ~4 s (blackholed P4 2 s + parallel fan-out 2 s).
#
# Debounce is wall-clock on the monotonic clock (/proc/uptime centiseconds, read
# with the `read` builtin): `reachable` flips false once the failure run, timed
# from the START of its first cycle, reaches fail_secs, and back to true once the
# success run reaches recover_secs. streak_success / streak_fail stay plain
# per-cycle counts (the watchdog's contract). The loop is fixed-rate: it sleeps
# what is left of the interval (fractional, 0.2 s floor).
#
# A probe succeeds only when a numeric round-trip time > 0 is parsed from the ping
# output (the "min/avg/max = a/b/c" summary, else a per-packet "time="). 100% loss
# prints no round-trip line, so no rtt, so failure: the fail-safe.
#
# Output: /tmp/qmanager_ping.json (printf, tmp + mv; the last good file is kept
#         when a write fails) and the /var/run/qmanager/ping.env poller sidecar.
# History: /tmp/qmanager_ping_history, one "<rtt|null> <leg>" line per cycle
#         (leg p4|s4|p6|s6|-), newest last, HISTORY_SIZE lines. Readers use $1.
# DNS: /tmp/qmanager_dns.json + dns.env from a detached job (see below).
#
# Stats (avg/min/max/jitter/loss) and the history JSON array are computed by the
# poller in one awk pass over the history file, not here.
#
# Install location: /usr/bin/qmanager_ping
# Dependencies: busybox ping (+ ping -6 or ping6), timeout, date, tail, mv, jq
# (DNS job only), nslookup (DNS job only)
# =============================================================================

# --- Logging -----------------------------------------------------------------
# Guarded with -f: BusyBox ash exits when `.` cannot find its file.
if [ -f /usr/lib/qmanager/qlog.sh ]; then
    . /usr/lib/qmanager/qlog.sh
else
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
    qlog_state_change() { :; }
    _MONO=0
    mono_now_set() {
        _MONO=""
        { read -r _MONO _mns_idle < /proc/uptime; } 2>/dev/null
        _MONO="${_MONO%%.*}"
        case "$_MONO" in ''|*[!0-9]*) _MONO=0 ;; esac
    }
fi
qlog_init "ping"

# --- Cadence table (conn_state_resolve) --------------------------------------
[ -f /usr/lib/qmanager/conn_state.sh ] && . /usr/lib/qmanager/conn_state.sh

# --- Root-safe runtime dir for the poller sidecars (qm_root_dir) -------------
[ -f /usr/lib/qmanager/safe_tmp.sh ] && . /usr/lib/qmanager/safe_tmp.sh

# --- Bounded command runner --------------------------------------------------
# No platform.sh on this target, so qm_timeout is defined here: the BusyBox
# `timeout SECS cmd` applet (exits 143 on kill), else the command runs unbounded.
if ! command -v qm_timeout >/dev/null 2>&1; then
    if command -v timeout >/dev/null 2>&1; then
        qm_timeout() { timeout "$@"; }
    else
        qm_timeout() { shift; "$@"; }
    fi
fi

# --- Configuration -----------------------------------------------------------
# Fallbacks only: load_config() re-reads UCI (quecmanager.ping_profile) at
# startup and on every reload-flag trip. The profile name drives interval +
# fail/recover seconds through conn_state_resolve (the one profile table).
PING_PROFILE="${PING_PROFILE:-relaxed}"
PING_TARGET_IPV4="1.1.1.1"
PING_TARGET_IPV6="2606:4700:4700::1111"
ALT_TARGET_IPV4="8.8.8.8"
ALT_TARGET_IPV6="2001:4860:4860::8888"
PING_INTERVAL=5
PING_INTERVAL_OVERRIDE=""  # quecmanager.ping_profile.interval_override (1-60); empty = unused
FAIL_THRESHOLD=3           # logged only: the verdict is timed, not counted
RECOVER_THRESHOLD=2
PING_FAIL_SECS=15          # time-to-fail / time-to-recover (seconds), published
PING_RECOVER_SECS=10       # in the cache as fail_secs / recover_secs
HISTORY_SIZE=60
PROBE_WAIT=2               # ping -W : wait for the first reply (s)
PROBE_DEADLINE=3           # ping -w : hard per-leg deadline (s)
HOST_DEADLINE=4            # timeout for a hostname P4 (-w does not bound the lookup)
SLEEP_FLOOR_CS=20          # fixed-rate loop: never sleep less than 0.2 s
# Attach warm-up: until the first probe answers (at most this long after start),
# a failed probe still drives the streaks and `reachable`, but it is not written to
# the history ring. At boot the daemon starts before the data call is up, and those
# pre-attach failures used to read as packet loss for a whole ring (~10 min).
ATTACH_GRACE_SECS=120

# IPv6 ping invocation, detected once at startup and on reload (detect_ping6).
# Empty = IPv6 probing unavailable on this build.
PING6_CMD=""
PING6_WARNED=0

# --- File Paths --------------------------------------------------------------
CACHE_FILE="/tmp/qmanager_ping.json"
CACHE_TMP="/tmp/qmanager_ping.json.tmp"
HISTORY_FILE="/tmp/qmanager_ping_history"
RECOVERY_FLAG="/tmp/qmanager_recovery_active"
RELOAD_FLAG="/tmp/qmanager_ping_reload"
PID_FILE="/tmp/qmanager_ping.pid"
ATTACH_FLAG="/tmp/qmanager_ping_attaching"   # present during the attach warm-up; the poller skips archive rows
IPV6_ROUTE="/proc/net/ipv6_route"

# Sidecars for the poller (B5.29 Phase C): the values it would otherwise extract
# from ping.json / dns.json with jq, as shell assignments, written tmp + mv right
# AFTER the JSON so they are never older than it unless a write failed (the
# poller then falls back to the JSON). Last line is an end marker.
SC_DIR="/var/run/qmanager"
SC_PING="$SC_DIR/ping.env"
SC_DNS="$SC_DIR/dns.env"
# Result files of the parallel fan-out (one per leg), inside the root-only dir.
FAN_DIR="$SC_DIR/ping_fan"

# --- State Variables ---------------------------------------------------------
streak_success=0
streak_fail=0
reachable="true"
last_family="none"     # ipv4 | ipv6 | none: which family answered last cycle
last_target=""         # the literal (or hostname) that answered last cycle, "" = none
last_leg="-"           # p4 | s4 | p6 | s6 | -
fail_elapsed_sec=0     # seconds into the current failure run, 0 when not failing
cycle_ms=0             # last measured cycle period (start to start), ms
history_count=0        # tracked in shell: avoids a wc -l fork every cycle
attach_until=""        # mono deadline of the attach warm-up; empty once it has ended
_fan_pids=""           # background leg jobs in flight (killed by the trap)
_fail_since=""         # centisecond start of the current failure run
_ok_since=""           # centisecond start of the current success run
_clk_last=0
_wc_warned=0

# =============================================================================
# HELPERS
# =============================================================================

# Sets _CS to /proc/uptime in centiseconds, no fork (no sub-second clock otherwise).
_uptime_cs() {
    _CS=0
    _u_up=""
    { read -r _u_up _u_idle < /proc/uptime; } 2>/dev/null
    _u_int="${_u_up%%.*}"
    case "$_u_int" in ''|*[!0-9]*) return 1 ;; esac
    case "$_u_up" in
        *.*) _u_frac="${_u_up#*.}" ;;
        *) _u_frac=0 ;;
    esac
    case "$_u_frac" in ???*) _u_frac="${_u_frac%"${_u_frac#??}"}" ;; esac
    case "$_u_frac" in ''|*[!0-9]*) _u_frac=0 ;; esac
    case "$_u_frac" in ?) _u_frac="${_u_frac}0" ;; esac
    # Leading zeros read as octal in $(( )) ("08" is an error), so strip them.
    while :; do
        case "$_u_frac" in 0?*) _u_frac="${_u_frac#0}" ;; *) break ;; esac
    done
    while :; do
        case "$_u_int" in 0?*) _u_int="${_u_int#0}" ;; *) break ;; esac
    done
    _CS=$(( _u_int * 100 + _u_frac ))
}

# _clock: _CS = monotonic centiseconds. If /proc/uptime cannot be parsed the
# clock still advances one interval per call, so a failure run still reaches
# fail_secs instead of freezing the verdict.
_clock() {
    if _uptime_cs; then
        _clk_last="$_CS"
        return 0
    fi
    _clk_last=$(( _clk_last + PING_INTERVAL * 100 ))
    _CS="$_clk_last"
}

# --- Resolve the active profile name to {interval, fail/recover seconds} ------
# The table lives in conn_state.sh (conn_state_resolve) so the CGIs, poller and
# watchcat see the cadence this daemon runs: sensitive 1/6/3, regular 2/10/6,
# relaxed 5/15/10, quiet 10/30/20 (interval / fail / recover s). interval_override
# changes only the probe cadence. Without the lib, relaxed stands.
resolve_profile() {
    if command -v conn_state_resolve >/dev/null 2>&1; then
        conn_state_resolve "$PING_PROFILE" "$PING_INTERVAL_OVERRIDE"
        PING_PROFILE="$CQ_CFG_PROFILE"
        PING_INTERVAL="$CQ_CFG_INTERVAL_SEC"
        PING_FAIL_SECS="$CQ_CFG_FAIL_SECS"
        PING_RECOVER_SECS="$CQ_CFG_RECOVER_SECS"
        FAIL_THRESHOLD="$CQ_CFG_FAIL_THRESHOLD"
        RECOVER_THRESHOLD="$CQ_CFG_RECOVER_THRESHOLD"
    else
        PING_PROFILE="relaxed"
        PING_INTERVAL=5
        PING_FAIL_SECS=15
        PING_RECOVER_SECS=10
        [ -n "$PING_INTERVAL_OVERRIDE" ] && PING_INTERVAL="$PING_INTERVAL_OVERRIDE"
    fi
}

# --- Detect a working IPv6 ping invocation (startup + reload) ----------------
# Prefer `ping -6`, then the `ping6` applet. Probe ::1 so detection never
# depends on the bearer. Sets PING6_CMD; empty means IPv6 probing is unavailable.
detect_ping6() {
    if ping -6 -c 1 -W 1 ::1 >/dev/null 2>&1; then
        PING6_CMD="ping -6"
        return 0
    fi
    if command -v ping6 >/dev/null 2>&1 && ping6 -c 1 -W 1 ::1 >/dev/null 2>&1; then
        PING6_CMD="ping6"
        return 0
    fi
    PING6_CMD=""
    if [ "$PING6_WARNED" = "0" ]; then
        qlog_warn "IPv6 probing unavailable (no working ping -6 or ping6), IPv4-only reachability"
        PING6_WARNED=1
    fi
    return 1
}

# Target charsets (same rules as ping_profile.sh validate_target, plus no leading
# '-' so a value can never be parsed as a ping option). Everything written into
# ping.json therefore needs no escaping beyond the profile name.
_target4_ok() {
    case "$1" in ''|-*|*[!0-9A-Za-z.-]*) return 1 ;; esac
    [ "${#1}" -le 128 ]
}
_target6_ok() {
    case "$1" in ''|-*|*[!0-9A-Fa-f:.%]*) return 1 ;; esac
    [ "${#1}" -le 128 ]
}

# The built-in alternate is "the other provider": Google when the primary is
# Cloudflare or anything custom, Cloudflare when the primary is already Google.
_set_alternates() {
    case "$PING_TARGET_IPV4" in
        8.8.8.8|8.8.4.4|dns.google) ALT_TARGET_IPV4="1.1.1.1" ;;
        *) ALT_TARGET_IPV4="8.8.8.8" ;;
    esac
    case "$PING_TARGET_IPV6" in
        2001:4860:4860:*) ALT_TARGET_IPV6="2606:4700:4700::1111" ;;
        *) ALT_TARGET_IPV6="2001:4860:4860::8888" ;;
    esac
}

# --- Load configuration from UCI and re-resolve the profile ------------------
# Profile name + the IPv4/IPv6 targets from quecmanager.ping_profile, falling back
# to relaxed / Cloudflare when a key is unset or fails the charset check. The
# legacy target_1/target_2 keys (old HTTP URLs) are deliberately NOT read.
load_config() {
    local _profile
    local _t4
    local _t6
    local _override

    _profile=$(uci -q get quecmanager.ping_profile.profile 2>/dev/null)
    _t4=$(uci -q get quecmanager.ping_profile.target_ipv4 2>/dev/null)
    _t6=$(uci -q get quecmanager.ping_profile.target_ipv6 2>/dev/null)
    _override=$(uci -q get quecmanager.ping_profile.interval_override 2>/dev/null)

    PING_PROFILE="relaxed"
    [ -n "$_profile" ] && PING_PROFILE="$_profile"

    # Reset to the defaults first so a cleared UCI key reverts on reload.
    PING_TARGET_IPV4="1.1.1.1"
    PING_TARGET_IPV6="2606:4700:4700::1111"
    if [ -n "$_t4" ]; then
        if _target4_ok "$_t4"; then
            PING_TARGET_IPV4="$_t4"
        else
            qlog_warn "target_ipv4 rejected (bad charset or length), using 1.1.1.1"
        fi
    fi
    if [ -n "$_t6" ]; then
        if _target6_ok "$_t6"; then
            PING_TARGET_IPV6="$_t6"
        else
            qlog_warn "target_ipv6 rejected (bad charset or length), using 2606:4700:4700::1111"
        fi
    fi
    _set_alternates

    # interval_override: integer seconds 1-60, else unused (reset first so a
    # cleared/invalid value reverts to the profile interval on reload).
    PING_INTERVAL_OVERRIDE=""
    case "$_override" in
        ''|*[!0-9]*) ;;
        *) [ "$_override" -ge 1 ] && [ "$_override" -le 60 ] && PING_INTERVAL_OVERRIDE="$_override" ;;
    esac

    resolve_profile
}

# --- RTT parse (builtins only) -----------------------------------------------
# parse_rtt <ping output>: _RTT = the average RTT, one decimal (rounded), from the
# "min/avg/max[/mdev] = a/b/c" summary, else the first "time=<n>". Returns 1 (and
# _RTT empty) when nothing numeric > 0 is found.
parse_rtt() {
    _RTT=""
    case "$1" in
        *"min/avg/max"*"= "*)
            _pr="${1#*min/avg/max}"
            _pr="${_pr#*= }"
            _pr="${_pr#*/}"
            _pr="${_pr%%/*}"
            ;;
        *"time="*)
            _pr="${1#*time=}"
            _pr="${_pr%% *}"
            ;;
        *) return 1 ;;
    esac
    case "$_pr" in ''|.*|*[!0-9.]*|*.*.*) return 1 ;; esac
    _pi="${_pr%%.*}"
    case "$_pr" in
        *.*) _pf="${_pr#*.}00" ;;
        *) _pf="00" ;;
    esac
    _pf="${_pf%"${_pf#??}"}"
    while :; do
        case "$_pi" in 0?*) _pi="${_pi#0}" ;; *) break ;; esac
    done
    [ "${#_pi}" -le 6 ] || return 1
    # Hundredths ("1$_pf - 100" keeps a leading-zero fraction out of octal), then
    # rounded to tenths.
    _pt=$(( _pi * 100 + 1$_pf - 100 ))
    _pt=$(( (_pt + 5) / 10 ))
    [ "$_pt" -gt 0 ] || return 1
    _RTT="$(( _pt / 10 )).$(( _pt % 10 ))"
}

# --- One leg ------------------------------------------------------------------
# probe_leg <target> <4|6>: one echo request with a hard deadline; _RTT on success.
probe_leg() {
    _pl_out=""
    if [ "$2" = "6" ]; then
        [ -n "$PING6_CMD" ] || return 1
        # $PING6_CMD is an internal fixed token ("ping -6" / "ping6"): intended split.
        # shellcheck disable=SC2086
        _pl_out=$($PING6_CMD -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
    else
        case "$1" in
            *[!0-9.]*)
                _pl_out=$(qm_timeout "$HOST_DEADLINE" ping -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
                ;;
            *)
                _pl_out=$(ping -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
                ;;
        esac
    fi
    parse_rtt "$_pl_out"
}

# Background body of one fan-out leg: writes the rtt (or nothing) to its file.
leg_job() { # target family file
    # Inherited traps would delete the daemon's PID file when this job exits.
    trap - EXIT INT TERM
    if probe_leg "$1" "$2"; then
        printf '%s\n' "$_RTT" > "$3"
    fi
    exit 0
}

# True when the kernel holds a usable IPv6 default route (::/0 not on lo).
# Read with builtins only; this runs on the failure path.
_ipv6_default_route() {
    [ -r "$IPV6_ROUTE" ] || return 1
    {
        while read -r _r_d _r_dl _r_s _r_sl _r_nh _r_m _r_rc _r_u _r_fl _r_dev; do
            [ "$_r_d" = "00000000000000000000000000000000" ] || continue
            [ "$_r_dl" = "00" ] || continue
            [ "$_r_dev" = "lo" ] && continue
            return 0
        done < "$IPV6_ROUTE"
    } 2>/dev/null
    return 1
}

_fan_kill() {
    [ -n "$_fan_pids" ] && kill $_fan_pids 2>/dev/null
    _fan_pids=""
}

# _fan_read <leg>: _FR = that leg's rtt, "" when it did not answer.
_fan_read() {
    _FR=""
    { read -r _FR < "$FAN_DIR/$1"; } 2>/dev/null
    case "$_FR" in ''|*[!0-9.]*) _FR="" ;; esac
}

# --- Probe one cycle ----------------------------------------------------------
# Sets PROBE_RTT, last_family, last_target, last_leg; returns 0 when any leg
# answered. Globals, not stdout: a $( ) subshell would lose them.
PROBE_RTT=""
probe_cycle() {
    if probe_leg "$PING_TARGET_IPV4" 4; then
        PROBE_RTT="$_RTT"
        last_family="ipv4"
        last_target="$PING_TARGET_IPV4"
        last_leg="p4"
        return 0
    fi

    # Fan-out: S4 always, the IPv6 legs only with a v6 default route.
    _pc_v6=0
    [ -n "$PING6_CMD" ] && _ipv6_default_route && _pc_v6=1
    if [ ! -d "$FAN_DIR" ]; then
        _sc_dir_ok
        mkdir -m 0700 "$FAN_DIR" 2>/dev/null
    fi
    _fan_pids=""
    if [ -d "$FAN_DIR" ]; then
        : > "$FAN_DIR/s4"
        leg_job "$ALT_TARGET_IPV4" 4 "$FAN_DIR/s4" </dev/null >/dev/null 2>&1 &
        _fan_pids="$!"
        if [ "$_pc_v6" = "1" ]; then
            : > "$FAN_DIR/p6"
            leg_job "$PING_TARGET_IPV6" 6 "$FAN_DIR/p6" </dev/null >/dev/null 2>&1 &
            _fan_pids="$_fan_pids $!"
            : > "$FAN_DIR/s6"
            leg_job "$ALT_TARGET_IPV6" 6 "$FAN_DIR/s6" </dev/null >/dev/null 2>&1 &
            _fan_pids="$_fan_pids $!"
        fi
        # shellcheck disable=SC2086
        wait $_fan_pids
        _fan_pids=""

        _fan_read s4
        if [ -n "$_FR" ]; then
            PROBE_RTT="$_FR"; last_family="ipv4"; last_target="$ALT_TARGET_IPV4"; last_leg="s4"
            return 0
        fi
        if [ "$_pc_v6" = "1" ]; then
            _fan_read p6
            if [ -n "$_FR" ]; then
                PROBE_RTT="$_FR"; last_family="ipv6"; last_target="$PING_TARGET_IPV6"; last_leg="p6"
                return 0
            fi
            _fan_read s6
            if [ -n "$_FR" ]; then
                PROBE_RTT="$_FR"; last_family="ipv6"; last_target="$ALT_TARGET_IPV6"; last_leg="s6"
                return 0
            fi
        fi
    else
        # No scratch dir (should not happen): the legs run one after another.
        if probe_leg "$ALT_TARGET_IPV4" 4; then
            PROBE_RTT="$_RTT"; last_family="ipv4"; last_target="$ALT_TARGET_IPV4"; last_leg="s4"
            return 0
        fi
        if [ "$_pc_v6" = "1" ]; then
            if probe_leg "$PING_TARGET_IPV6" 6; then
                PROBE_RTT="$_RTT"; last_family="ipv6"; last_target="$PING_TARGET_IPV6"; last_leg="p6"
                return 0
            fi
            if probe_leg "$ALT_TARGET_IPV6" 6; then
                PROBE_RTT="$_RTT"; last_family="ipv6"; last_target="$ALT_TARGET_IPV6"; last_leg="s6"
                return 0
            fi
        fi
    fi

    PROBE_RTT=""
    last_family="none"
    last_target=""
    last_leg="-"
    return 1
}

# --- JSON string escape (builtins) -------------------------------------------
# _JS = $1 with \ and " backslash-escaped. Targets are charset-checked, so in
# practice only a hand-edited profile name can carry either.
_json_str() {
    _js_in="$1"
    _JS=""
    while :; do
        case "$_js_in" in
            *[\\\"]*)
                _js_pre=${_js_in%%[\\\"]*}
                _js_in=${_js_in#"$_js_pre"}
                _js_c=${_js_in%"${_js_in#?}"}
                _js_in=${_js_in#?}
                _JS="${_JS}${_js_pre}\\${_js_c}"
                ;;
            *)
                _JS="${_JS}${_js_in}"
                break
                ;;
        esac
    done
}

# --- Write the JSON cache atomically -----------------------------------------
# Keys: timestamp, mono, profile, targets, interval_sec, fail_secs, recover_secs,
# last_rtt_ms, reachable, streak_success, streak_fail, during_recovery,
# last_family, last_target, fail_elapsed_sec, cycle_ms. A failed write keeps the
# previous file (readers would otherwise see an empty or partial one) and skips
# the sidecar, which must never be newer than a JSON it does not match.
write_cache() {
    local rtt="$1"      # "34.2" or "null"
    local timestamp
    local during_recovery="false"
    local _jp
    local _jt4
    local _jt6
    local _jlt

    timestamp=$(date +%s)
    case "$timestamp" in ''|*[!0-9]*) timestamp=0 ;; esac
    mono_now_set
    [ -f "$RECOVERY_FLAG" ] && during_recovery="true"
    case "$rtt" in ''|*[!0-9.]*) rtt="null" ;; esac

    _json_str "$PING_PROFILE"; _jp="$_JS"
    _json_str "$PING_TARGET_IPV4"; _jt4="$_JS"
    _json_str "$PING_TARGET_IPV6"; _jt6="$_JS"
    _json_str "$last_target"; _jlt="$_JS"

    if printf '{"timestamp":%s,"mono":%s,"profile":"%s","targets":["%s","%s"],"interval_sec":%s,"fail_secs":%s,"recover_secs":%s,"last_rtt_ms":%s,"reachable":%s,"streak_success":%s,"streak_fail":%s,"during_recovery":%s,"last_family":"%s","last_target":"%s","fail_elapsed_sec":%s,"cycle_ms":%s}\n' \
            "$timestamp" "${_MONO:-0}" "$_jp" "$_jt4" "$_jt6" \
            "${PING_INTERVAL:-5}" "${PING_FAIL_SECS:-15}" "${PING_RECOVER_SECS:-10}" \
            "$rtt" "${reachable:-true}" "${streak_success:-0}" "${streak_fail:-0}" \
            "$during_recovery" "${last_family:-none}" "$_jlt" \
            "${fail_elapsed_sec:-0}" "${cycle_ms:-0}" > "$CACHE_TMP" 2>/dev/null \
        && [ -s "$CACHE_TMP" ] \
        && mv -f "$CACHE_TMP" "$CACHE_FILE" 2>/dev/null; then
        _wc_warned=0
        write_ping_env "$timestamp" "${_MONO:-0}" "$rtt" "$during_recovery"
    else
        rm -f "$CACHE_TMP" 2>/dev/null
        if [ "${_wc_warned:-0}" = "0" ]; then
            qlog_warn "ping cache write failed, keeping the previous file"
            _wc_warned=1
        fi
    fi
    return 0
}

# --- Sidecar helpers ---------------------------------------------------------
# _sc_sq <value>: _SCQ = value single-quoted for sh ('  ->  '\''). Empty -> '-'
# (the poller's "no value" token, same as conn_state_read's jq mapping).
_sc_sq() {
    _scq_in="${1:--}"
    _SCQ=""
    while :; do
        case "$_scq_in" in
            *\'*)
                _SCQ="${_SCQ}${_scq_in%%\'*}'\\''"
                _scq_in="${_scq_in#*\'}"
                ;;
            *)
                _SCQ="'${_SCQ}${_scq_in}'"
                break
                ;;
        esac
    done
}

# _sc_dir_ok: SC_DIR exists as a root-owned dir (re-created if /var/run was cleared).
_sc_dir_ok() {
    [ -d "$SC_DIR" ] && return 0
    if command -v qm_root_dir >/dev/null 2>&1; then
        qm_root_dir "$SC_DIR" 0700
    else
        mkdir -m 0700 "$SC_DIR" 2>/dev/null
    fi
}

# write_ping_env <timestamp> <mono> <rtt> <during_recovery>: the 15 raw fields
# conn_state_read extracts from ping.json (null/empty -> '-'), i.e. what
# conn_state_read_env sources. Best effort: a failure only means the poller
# falls back to reading ping.json.
write_ping_env() {
    _sc_dir_ok || return 1
    {
        _sc_sq "$1";                printf '_cq_ts=%s\n' "$_SCQ"
        _sc_sq "$2";                printf '_cq_mono=%s\n' "$_SCQ"
        _sc_sq "$reachable";        printf '_cq_reach=%s\n' "$_SCQ"
        case "$3" in null) _sc_sq "-" ;; *) _sc_sq "$3" ;; esac
        printf '_cq_rtt=%s\n' "$_SCQ"
        _sc_sq "$streak_success";   printf '_cq_ss=%s\n' "$_SCQ"
        _sc_sq "$streak_fail";      printf '_cq_sf=%s\n' "$_SCQ"
        _sc_sq "$4";                printf '_cq_dr=%s\n' "$_SCQ"
        _sc_sq "$PING_INTERVAL";    printf '_cq_iv=%s\n' "$_SCQ"
        _sc_sq "$PING_FAIL_SECS";   printf '_cq_fs=%s\n' "$_SCQ"
        _sc_sq "$PING_RECOVER_SECS"; printf '_cq_rs=%s\n' "$_SCQ"
        _sc_sq "$PING_PROFILE";     printf '_cq_prof=%s\n' "$_SCQ"
        _sc_sq "$last_family";      printf '_cq_fam=%s\n' "$_SCQ"
        _sc_sq "$PING_TARGET_IPV4"; printf '_cq_tgt=%s\n' "$_SCQ"
        _sc_sq "$last_target";      printf '_cq_last_target=%s\n' "$_SCQ"
        _sc_sq "${cycle_ms:-0}";    printf '_cq_cyc=%s\n' "$_SCQ"
        printf "qm_sidecar_end='1'\n"
    } 2>/dev/null > "${SC_PING}.new" \
        && mv -f "${SC_PING}.new" "$SC_PING" 2>/dev/null \
        || { rm -f "${SC_PING}.new" 2>/dev/null; return 1; }
    return 0
}

# write_dns_env <ok> <ms> <mono> <resolver>: the four fields the poller reads
# from dns.json (ms is "null" when the lookup failed).
write_dns_env() {
    _sc_dir_ok || return 1
    {
        _sc_sq "$1"; printf 'dns_s_ok=%s\n' "$_SCQ"
        _sc_sq "$2"; printf 'dns_s_ms=%s\n' "$_SCQ"
        _sc_sq "$3"; printf 'dns_s_mono=%s\n' "$_SCQ"
        _sc_sq "${4:-null}"; printf 'dns_s_res=%s\n' "$_SCQ"
        printf "qm_sidecar_end='1'\n"
    } 2>/dev/null > "${SC_DNS}.new" \
        && mv -f "${SC_DNS}.new" "$SC_DNS" 2>/dev/null \
        || { rm -f "${SC_DNS}.new" 2>/dev/null; return 1; }
    return 0
}

# =============================================================================
# DNS LOOKUP LATENCY (detached job — the probe loop's budget must not grow)
# =============================================================================
DNS_NAME="one.one.one.one"
DNS_FILE="${DNS_FILE:-/tmp/qmanager_dns.json}"
RESOLV_CONF="${RESOLV_CONF:-/etc/resolv.conf}"
DNS_INTERVAL=60          # seconds between scheduled lookups
DNS_MIN_GAP=10           # floor between lookups when an outage edge forces one
DNS_LOOKUP_TIMEOUT=5     # hard bound on the nslookup itself
DNS_JOB_MAX=15           # a job older than this is presumed gone (pid-reuse guard)
_dns_pid=""
_dns_started=""          # whole uptime seconds of the last spawn, "" = never
_dns_force=0             # 1 = lookup on the next free slot, interval or not
_dns_prev_reach=""
_dm=0

# The detached job: first nameserver in resolv.conf, re-read every run (it changes on reattach).
dns_job() {
    # Inherited traps would delete the daemon's PID file when this job exits.
    trap - EXIT INT TERM
    _res=$(awk '$1 == "nameserver" { print $2; exit }' "$RESOLV_CONF" 2>/dev/null)
    case "$_res" in *[!0-9A-Za-z:.%_-]*) _res="" ;; esac
    _ms="null"
    _ok="false"
    if [ -n "$_res" ]; then
        _out=$(mktemp /tmp/qmanager_dns_out.XXXXXX 2>/dev/null)
        if [ -n "$_out" ]; then
            _uptime_cs; _t0="$_CS"
            qm_timeout "$DNS_LOOKUP_TIMEOUT" nslookup "$DNS_NAME" "$_res" >"$_out" 2>&1 </dev/null
            _rc=$?
            _uptime_cs; _t1="$_CS"
            # Success = exit 0 and an Address line after a Name line (the server header has one too).
            if [ "$_rc" -eq 0 ] && awk '/^Name:/ { n = 1; next } n && /^Address/ { f = 1 } END { exit !f }' "$_out"; then
                _ok="true"
                _ms=$(( (_t1 - _t0) * 10 ))
                [ "$_ms" -lt 10 ] && _ms=10
            fi
            rm -f "$_out"
        fi
    fi

    _uptime_cs
    _tmp=$(mktemp "${DNS_FILE}.XXXXXX" 2>/dev/null) || exit 0
    if jq -n --argjson ms "$_ms" --argjson ok "$_ok" --arg res "$_res" --arg name "$DNS_NAME" \
            --argjson mono "$((_CS / 100))" --argjson ts "$(date +%s)" \
            '{ms: $ms, ok: $ok, resolver: $res, name: $name, mono: $mono, ts: $ts}' > "$_tmp" 2>/dev/null \
        && chmod 644 "$_tmp" && mv "$_tmp" "$DNS_FILE"; then
        write_dns_env "$_ok" "$_ms" "$((_CS / 100))" "$_res"
    else
        rm -f "$_tmp"
    fi
    exit 0
}

# True while the last spawned job runs. A reaped or zombie pid is free; so is one older than DNS_JOB_MAX.
_dns_busy() {
    [ -n "$_dns_pid" ] || return 1
    _dl=""
    { read -r _dl < "/proc/$_dns_pid/stat"; } 2>/dev/null
    case "$_dl" in
        ''|*") Z "*) _dns_pid=""; return 1 ;;
    esac
    if [ $((_dm - _dns_started)) -ge "$DNS_JOB_MAX" ]; then
        _dns_pid=""
        return 1
    fi
    return 0
}

# Once per cycle, after the verdict is written: spawns at most one detached job.
dns_probe_maybe() {
    _uptime_cs || return 0
    _dm=$((_CS / 100))
    # A true -> false edge forces a fresh lookup so an outage never shows an old good number.
    if [ "$_dns_prev_reach" = "true" ] && [ "$reachable" = "false" ]; then
        _dns_force=1
    fi
    _dns_prev_reach="$reachable"

    _due=0
    if [ -z "$_dns_started" ]; then
        _due=1
    elif [ "$_dns_force" -eq 1 ]; then
        [ $((_dm - _dns_started)) -ge "$DNS_MIN_GAP" ] && _due=1
    elif [ $((_dm - _dns_started)) -ge "$DNS_INTERVAL" ]; then
        _due=1
    fi
    [ "$_due" -eq 1 ] || return 0
    _dns_busy && return 0

    _dns_started="$_dm"
    _dns_force=0
    dns_job </dev/null >/dev/null 2>&1 &
    _dns_pid=$!
    return 0
}

# =============================================================================
# MAIN LOOP
# =============================================================================

# Fixed-rate sleep: what is left of the interval after this cycle, floored at
# SLEEP_FLOOR_CS, as a fractional "S.CC" argument (BusyBox sleep takes one).
_cycle_sleep() { # cycle start (cs)
    _clock
    _cs_left=$(( PING_INTERVAL * 100 - (_CS - $1) ))
    [ "$_cs_left" -lt "$SLEEP_FLOOR_CS" ] && _cs_left="$SLEEP_FLOOR_CS"
    _cs_frac=$(( _cs_left % 100 ))
    [ "$_cs_frac" -lt 10 ] && _cs_frac="0$_cs_frac"
    sleep "$(( _cs_left / 100 )).$_cs_frac"
}

_cleanup() {
    _fan_kill
    rm -f "$PID_FILE" "$CACHE_TMP" "${SC_PING}.new" "$ATTACH_FLAG" 2>/dev/null
    rm -rf "$FAN_DIR" 2>/dev/null
}

main() {
    local _cyc_start
    local _cyc_prev=""
    local _probe_end
    local _el
    local rtt
    local record
    local old_pid

    # Prevent duplicate instances
    if [ -f "$PID_FILE" ]; then
        old_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            qlog_error "Another ping daemon already running (PID $old_pid), exiting"
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
    echo $$ > "$PID_FILE"

    # BusyBox ash runs an INT/TERM trap handler but does NOT exit afterward, so
    # the INT/TERM trap ends in an explicit `exit` (confirmed on RM551E
    # 2026-06-26, docs/development/busybox-quirks.md). The fan-out jobs are
    # killed and their scratch dir removed on every path.
    trap '_cleanup' EXIT
    trap '_cleanup; exit 0' INT TERM

    load_config
    detect_ping6

    qlog_info "========================================"
    qlog_info "QManager Ping Daemon starting (PID $$)"
    qlog_info "Profile: ${PING_PROFILE}, interval ${PING_INTERVAL}s${PING_INTERVAL_OVERRIDE:+ (override)}, fail ${PING_FAIL_SECS}s, recover ${PING_RECOVER_SECS}s"
    qlog_info "Legs: p4=${PING_TARGET_IPV4} s4=${ALT_TARGET_IPV4} p6=${PING_TARGET_IPV6} s6=${ALT_TARGET_IPV6}"
    qlog_info "IPv6 probe: ${PING6_CMD:-unavailable}, history ${HISTORY_SIZE}, leg deadline ${PROBE_DEADLINE}s"
    qlog_info "========================================"

    # Clean up stale files from a previous run
    rm -f "$CACHE_TMP" /tmp/qmanager_dns_out.* "${DNS_FILE}".?????? "${SC_PING}.new" "${SC_DNS}.new"
    rm -rf "$FAN_DIR"
    _sc_dir_ok
    : > "$HISTORY_FILE"
    history_count=0
    mono_now_set
    attach_until=$((_MONO + ATTACH_GRACE_SECS))
    : > "$ATTACH_FLAG"
    _clock

    while true; do
        # Live reload: re-read UCI within one cycle when the CGI drops the flag.
        if [ -f "$RELOAD_FLAG" ]; then
            load_config
            detect_ping6
            rm -f "$RELOAD_FLAG"
            qlog_info "Reloaded config: profile=${PING_PROFILE} interval=${PING_INTERVAL}s${PING_INTERVAL_OVERRIDE:+ (override)} fail=${PING_FAIL_SECS}s recover=${PING_RECOVER_SECS}s p4=${PING_TARGET_IPV4} s4=${ALT_TARGET_IPV4} p6=${PING_TARGET_IPV6} s6=${ALT_TARGET_IPV6} ping6=${PING6_CMD:-none}"
        fi

        _clock
        _cyc_start="$_CS"
        if [ -n "$_cyc_prev" ]; then
            cycle_ms=$(( (_cyc_start - _cyc_prev) * 10 ))
        else
            cycle_ms=$(( PING_INTERVAL * 1000 ))
        fi
        _cyc_prev="$_cyc_start"

        record=1
        if probe_cycle; then
            rtt="$PROBE_RTT"
        else
            rtt=""
        fi
        _clock
        _probe_end="$_CS"

        if [ -n "$rtt" ]; then
            # --- A leg answered ---
            streak_success=$((streak_success + 1))
            streak_fail=0
            _fail_since=""
            fail_elapsed_sec=0
            [ -z "$_ok_since" ] && _ok_since="$_cyc_start"
            _el=$(( _probe_end - _ok_since ))

            qlog_debug "PING OK: leg=${last_leg} target=${last_target} rtt=${rtt}ms (streak_success=${streak_success})"

            if [ "$reachable" = "false" ] && [ "$_el" -ge $(( PING_RECOVER_SECS * 100 )) ]; then
                reachable="true"
                qlog_state_change "reachable" "false" "true"
            fi

            if [ -n "$attach_until" ]; then
                attach_until=""
                rm -f "$ATTACH_FLAG"
                qlog_info "First probe answered, attach warm-up over"
            fi

            echo "$rtt $last_leg" >> "$HISTORY_FILE"
        else
            # --- Every leg failed ---
            rtt="null"
            streak_fail=$((streak_fail + 1))
            streak_success=0
            _ok_since=""
            [ -z "$_fail_since" ] && _fail_since="$_cyc_start"
            _el=$(( _probe_end - _fail_since ))
            [ "$_el" -lt 0 ] && _el=0
            fail_elapsed_sec=$(( _el / 100 ))

            qlog_debug "PING FAIL: no leg answered (streak_fail=${streak_fail}, fail_elapsed=${fail_elapsed_sec}s)"

            if [ "$reachable" = "true" ] && [ "$_el" -ge $(( PING_FAIL_SECS * 100 )) ]; then
                reachable="false"
                qlog_state_change "reachable" "true" "false"
                qlog_warn "Internet unreachable after ${fail_elapsed_sec}s of continuous failure (${streak_fail} probes)"
            fi

            if [ -n "$attach_until" ]; then
                mono_now_set
                if [ "$_MONO" -lt "$attach_until" ]; then
                    record=0
                else
                    attach_until=""
                    rm -f "$ATTACH_FLAG"
                    qlog_warn "No probe answered within ${ATTACH_GRACE_SECS}s of start, recording failures"
                fi
            fi

            [ "$record" -eq 1 ] && echo "null -" >> "$HISTORY_FILE"
        fi

        # Trim the ring with the shell counter (no wc -l fork)
        if [ "$record" -eq 1 ]; then
            history_count=$((history_count + 1))
            if [ "$history_count" -gt "$HISTORY_SIZE" ]; then
                tail -n "$HISTORY_SIZE" "$HISTORY_FILE" > "${HISTORY_FILE}.tmp"
                mv "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
                history_count=$HISTORY_SIZE
            fi
        fi

        write_cache "$rtt"

        dns_probe_maybe

        _cycle_sleep "$_cyc_start"
    done
}

# Sourcing for tests: QM_PING_NO_MAIN=1 defines everything without running.
[ "${QM_PING_NO_MAIN:-0}" = "1" ] || main "$@"
