#!/bin/sh
# =============================================================================
# qmanager_ping — QManager Unified Ping Daemon
# =============================================================================
# The SINGLE source of internet reachability and latency data. Every consumer
# (poller, watchcat, frontend via status.json) reads this daemon's output. It
# never touches the modem serial port.
#
# Probing is ICMP (BusyBox ping), never HTTP. Four target SLOTS (connection_quality
# targets, defaults 1.1.1.1 8.8.8.8 2606:4700:4700::1111 cloudflare.com); each is an
# IPv4 literal, an IPv6 literal or a hostname.
#
# Cycle: the first usable slot alone (`ping -c1 -W2 -w3`, a hard 3 s deadline; a
# hostname gets `plat_timeout 4` as well because -w does not cover the lookup).
# A slot whose address family has no route (an IPv6 literal with no non-lo ::/0
# route, or no working ping -6) is skipped, not failed, and the next usable slot
# is promoted to "alone". A healthy cycle sends one probe. When that fails, every
# other usable slot runs IN PARALLEL; the result files are polled every 0.2 s and
# the winner is the lowest-numbered slot that answered, decided as soon as every
# lower slot has finished. The rest are killed (with their ping children), so the
# fan-out never waits for its slowest leg.
#
# Debounce is wall-clock on the monotonic clock (/proc/uptime centiseconds, read
# with the `read` builtin): `reachable` flips false once the failure run, timed
# from the START of its first cycle, reaches fail_secs, and back to true once the
# success run reaches recover_secs. streak_success / streak_fail stay plain
# per-cycle counts (the watchdog's contract). The loop is fixed-rate: it sleeps
# what is left of the interval (fractional, 0.2 s floor).
#
# A probe succeeds only when a numeric round-trip time > 0 is parsed from the ping
# output (the "min/avg/max = a/b/c" summary, else a per-packet "time="). 100% loss
# prints no round-trip line, so no rtt, so failure: the fail-safe.
#
# Output: /tmp/qmanager_ping.json (printf, tmp + mv; the last good file is kept
#         when a write fails), the PF_RUN_DIR/ping.env poller sidecar and
#         /tmp/qmanager_ping_slots.json (per-slot state of the last cycle).
# History: /tmp/qmanager_ping_history, one "<rtt|null> <slot>" line per cycle
#         (slot 1-4, or - when nothing answered), newest last. Length = ring
#         size (ceil(window / interval), conn_state_resolve); trimmed to it
#         only once the count passes size + 10. Readers use $1.
# DNS: /tmp/qmanager_dns.json + dns.env from a detached job (see below).
#
# Stats (avg/min/max/jitter/loss) and the history points are computed by the
# poller through cq_ring_stats (conn_state.sh), not here.
#
# Install location: /usr/bin/qmanager_ping
# Dependencies: busybox ping (+ ping -6 or ping6), qm_platform_cqwd.sh, date,
# tail, mv, jq
# (DNS job only), nslookup (DNS job only)
# =============================================================================

# --- Logging -----------------------------------------------------------------
# Guarded with -f: BusyBox ash exits when `.` cannot find its file.
if [ -f /usr/lib/qmanager/qlog.sh ]; then
    . /usr/lib/qmanager/qlog.sh
else
    qlog_init() { :; }
    qlog_debug() { :; }
    qlog_info() { :; }
    qlog_warn() { :; }
    qlog_error() { :; }
    qlog_state_change() { :; }
    _MONO=0
    mono_now_set() {
        _MONO=""
        { read -r _MONO _mns_idle < /proc/uptime; } 2>/dev/null
        _MONO="${_MONO%%.*}"
        case "$_MONO" in ''|*[!0-9]*) _MONO=0 ;; esac
    }
fi
qlog_init "ping"

# --- Cadence table (conn_state_resolve) --------------------------------------
[ -f /usr/lib/qmanager/conn_state.sh ] && . /usr/lib/qmanager/conn_state.sh

# --- Root-safe runtime dir for the poller sidecars (qm_root_dir) -------------
[ -f /usr/lib/qmanager/safe_tmp.sh ] && . /usr/lib/qmanager/safe_tmp.sh

# --- Platform adapter (cfg_get, plat_timeout, PF_* paths) ---------------------
# conn_state.sh already sourced it (idempotent). Required: main() refuses to
# start without it.
[ -f /usr/lib/qmanager/qm_platform_cqwd.sh ] && . /usr/lib/qmanager/qm_platform_cqwd.sh

# --- Configuration -----------------------------------------------------------
# Fallbacks only: load_config() re-reads the config (connection_quality) at
# startup and on every reload-flag trip. The sensitivity name drives interval,
# fail/recover seconds and the ring size through conn_state_resolve (the one
# sensitivity table).
PING_SENS="${PING_SENS:-relaxed}"
# The four target slots (connection_quality targets), slot 1 first.
DEF_T1="1.1.1.1"
DEF_T2="8.8.8.8"
DEF_T3="2606:4700:4700::1111"
DEF_T4="cloudflare.com"
PING_T1="$DEF_T1"
PING_T2="$DEF_T2"
PING_T3="$DEF_T3"
PING_T4="$DEF_T4"
PING_INTERVAL=5
PING_FAIL_SECS=20          # time-to-fail / time-to-recover (seconds), published
PING_RECOVER_SECS=10       # in the cache as fail_secs / recover_secs
HISTORY_SIZE=60            # ring length = ceil(window / interval), from the table
PROBE_WAIT=2               # ping -W : wait for the first reply (s)
PROBE_DEADLINE=3           # ping -w : hard per-leg deadline (s)
HOST_DEADLINE=4            # timeout for a hostname slot (-w does not bound the lookup)
FAN_POLL="0.2"             # fan-out: how often the result files are polled (s)
SLEEP_FLOOR_CS=20          # fixed-rate loop: never sleep less than 0.2 s
# Attach warm-up: until the first probe answers (at most this long after start),
# a failed probe still drives the streaks and `reachable`, but it is not written to
# the history ring. At boot the daemon starts before the data call is up, and those
# pre-attach failures used to read as packet loss for a whole ring (~10 min).
ATTACH_GRACE_SECS=120

# IPv6 ping invocation, detected once at startup and on reload (detect_ping6).
# Empty = IPv6 probing unavailable on this build.
PING6_CMD=""
PING6_WARNED=0

# --- File Paths --------------------------------------------------------------
CACHE_FILE="/tmp/qmanager_ping.json"
CACHE_TMP="/tmp/qmanager_ping.json.tmp"
HISTORY_FILE="/tmp/qmanager_ping_history"
SLOTS_FILE="/tmp/qmanager_ping_slots.json"
SLOTS_TMP="/tmp/qmanager_ping_slots.json.tmp"
RECOVERY_FLAG="/tmp/qmanager_recovery_active"
RELOAD_FLAG="$PF_PING_RELOAD"
PID_FILE="/tmp/qmanager_ping.pid"
ATTACH_FLAG="/tmp/qmanager_ping_attaching"   # present during the attach warm-up; the poller skips archive rows
IPV6_ROUTE="/proc/net/ipv6_route"

# Sidecars for the poller (B5.29 Phase C): the values it would otherwise extract
# from ping.json / dns.json with jq, as shell assignments, written tmp + mv right
# AFTER the JSON so they are never older than it unless a write failed (the
# poller then falls back to the JSON). Last line is an end marker.
SC_DIR="$PF_RUN_DIR"
SC_PING="$SC_DIR/ping.env"
SC_DNS="$SC_DIR/dns.env"
# Result files of the parallel fan-out (one per slot), inside the root-only dir.
FAN_DIR="$SC_DIR/ping_fan"

# --- State Variables ---------------------------------------------------------
streak_success=0
streak_fail=0
reachable="true"
last_family="none"     # ipv4 | ipv6 | none: which family answered last cycle
last_leg=0             # slot (1-4) that answered last cycle, 0 = none
# Per-slot outcome of the last cycle (SS = state, SR = rtt or "null"):
# ok | miss | skipped | standby.
SS1="standby"; SS2="standby"; SS3="standby"; SS4="standby"
SR1="null"; SR2="null"; SR3="null"; SR4="null"
fail_elapsed_sec=0     # seconds into the current failure run, 0 when not failing
cycle_ms=0             # last measured cycle period (start to start), ms
history_count=0        # tracked in shell: avoids a wc -l fork every cycle
attach_until=""        # mono deadline of the attach warm-up; empty once it has ended
_fan_pids=""           # background leg jobs in flight (killed by the trap)
_fail_since=""         # centisecond start of the current failure run
_ok_since=""           # centisecond start of the current success run
_clk_last=0
_wc_warned=0

# =============================================================================
# HELPERS
# =============================================================================

# Sets _CS to /proc/uptime in centiseconds, no fork (no sub-second clock otherwise).
_uptime_cs() {
    _CS=0
    _u_up=""
    { read -r _u_up _u_idle < /proc/uptime; } 2>/dev/null
    _u_int="${_u_up%%.*}"
    case "$_u_int" in ''|*[!0-9]*) return 1 ;; esac
    case "$_u_up" in
        *.*) _u_frac="${_u_up#*.}" ;;
        *) _u_frac=0 ;;
    esac
    case "$_u_frac" in ???*) _u_frac="${_u_frac%"${_u_frac#??}"}" ;; esac
    case "$_u_frac" in ''|*[!0-9]*) _u_frac=0 ;; esac
    case "$_u_frac" in ?) _u_frac="${_u_frac}0" ;; esac
    # Leading zeros read as octal in $(( )) ("08" is an error), so strip them.
    while :; do
        case "$_u_frac" in 0?*) _u_frac="${_u_frac#0}" ;; *) break ;; esac
    done
    while :; do
        case "$_u_int" in 0?*) _u_int="${_u_int#0}" ;; *) break ;; esac
    done
    _CS=$(( _u_int * 100 + _u_frac ))
}

# _clock: _CS = monotonic centiseconds. If /proc/uptime cannot be parsed the
# clock still advances one interval per call, so a failure run still reaches
# fail_secs instead of freezing the verdict.
_clock() {
    if _uptime_cs; then
        _clk_last="$_CS"
        return 0
    fi
    _clk_last=$(( _clk_last + PING_INTERVAL * 100 ))
    _CS="$_clk_last"
}

# --- Resolve the sensitivity to {interval, fail/recover seconds, ring size} ---
# The table lives in conn_state.sh (conn_state_resolve) so the CGIs, poller and
# watchcat see the cadence this daemon runs. Without the lib, relaxed stands.
resolve_sensitivity() {
    if command -v conn_state_resolve >/dev/null 2>&1; then
        conn_state_resolve "$PING_SENS"
        PING_SENS="$CQ_CFG_SENSITIVITY"
        PING_INTERVAL="$CQ_CFG_INTERVAL_SEC"
        PING_FAIL_SECS="$CQ_CFG_FAIL_SECS"
        PING_RECOVER_SECS="$CQ_CFG_RECOVER_SECS"
        HISTORY_SIZE="$CQ_CFG_RING_SIZE"
    else
        PING_SENS="relaxed"
        PING_INTERVAL=5
        PING_FAIL_SECS=20
        PING_RECOVER_SECS=10
        HISTORY_SIZE=60
    fi
}

# --- Detect a working IPv6 ping invocation (startup + reload) ----------------
# Prefer `ping -6`, then the `ping6` applet. Probe ::1 so detection never
# depends on the bearer. Sets PING6_CMD; empty means IPv6 probing is unavailable.
detect_ping6() {
    if ping -6 -c 1 -W 1 ::1 >/dev/null 2>&1; then
        PING6_CMD="ping -6"
        return 0
    fi
    if command -v ping6 >/dev/null 2>&1 && ping6 -c 1 -W 1 ::1 >/dev/null 2>&1; then
        PING6_CMD="ping6"
        return 0
    fi
    PING6_CMD=""
    if [ "$PING6_WARNED" = "0" ]; then
        qlog_warn "IPv6 probing unavailable (no working ping -6 or ping6), IPv4-only reachability"
        PING6_WARNED=1
    fi
    return 1
}

# Target rule (contract 5.2, same as the CGI): IPv4 literal, IPv6 literal or
# hostname; non-empty, at most 128 chars, charset [0-9A-Za-z.:%-], no leading '-'
# so a value can never be parsed as a ping option. Everything written into
# ping.json therefore needs no escaping beyond the sensitivity name.
_target_ok() {
    case "$1" in ''|-*|*[!0-9A-Za-z.:%-]*) return 1 ;; esac
    [ "${#1}" -le 128 ]
}

# _t_kind <target>: _TK = v6 (has a colon) | host (anything but digits and dots) | v4.
_t_kind() {
    case "$1" in
        *:*) _TK="v6" ;;
        *[!0-9.]*) _TK="host" ;;
        *) _TK="v4" ;;
    esac
}

# _slot_target <1-4>: _ST = that slot's target.
_slot_target() {
    case "$1" in
        1) _ST="$PING_T1" ;;
        2) _ST="$PING_T2" ;;
        3) _ST="$PING_T3" ;;
        *) _ST="$PING_T4" ;;
    esac
}

# _slot_set <1-4> <state> <rtt|"">: record one slot's outcome of this cycle.
_slot_set() {
    _ss_r="${3:-null}"
    case "$1" in
        1) SS1="$2"; SR1="$_ss_r" ;;
        2) SS2="$2"; SR2="$_ss_r" ;;
        3) SS3="$2"; SR3="$_ss_r" ;;
        *) SS4="$2"; SR4="$_ss_r" ;;
    esac
}

# --- Load configuration (cfg_get) and re-resolve the sensitivity -----------------
# Sensitivity + the four target slots from connection_quality. A missing
# targets list (before the migration seeds it) reads as the defaults; a slot
# that fails the rule falls back to its own default with a warning.
load_config() {
    local _sens
    local _tl
    local _tv
    local _i

    _sens=$(cfg_get connection_quality sensitivity)
    [ -z "$_sens" ] && _sens=$(cfg_get connection_quality profile)
    _tl=$(cfg_get_list connection_quality targets)

    PING_SENS="relaxed"
    [ -n "$_sens" ] && PING_SENS="$_sens"

    # Reset to the defaults first so a cleared list reverts on reload.
    PING_T1="$DEF_T1"
    PING_T2="$DEF_T2"
    PING_T3="$DEF_T3"
    PING_T4="$DEF_T4"
    if [ -n "$_tl" ]; then
        _i=0
        while IFS= read -r _tv; do
            _i=$((_i + 1))
            [ "$_i" -le 4 ] || break
            if _target_ok "$_tv"; then
                case "$_i" in
                    1) PING_T1="$_tv" ;;
                    2) PING_T2="$_tv" ;;
                    3) PING_T3="$_tv" ;;
                    *) PING_T4="$_tv" ;;
                esac
            else
                qlog_warn "target slot $_i rejected (empty, bad charset or length), using its default"
            fi
        done <<EOT
$_tl
EOT
    fi

    resolve_sensitivity
}

# --- RTT parse (builtins only) -----------------------------------------------
# parse_rtt <ping output>: _RTT = the average RTT, one decimal (rounded), from the
# "min/avg/max[/mdev] = a/b/c" summary, else the first "time=<n>". Returns 1 (and
# _RTT empty) when nothing numeric > 0 is found.
parse_rtt() {
    _RTT=""
    case "$1" in
        *"min/avg/max"*"= "*)
            _pr="${1#*min/avg/max}"
            _pr="${_pr#*= }"
            _pr="${_pr#*/}"
            _pr="${_pr%%/*}"
            ;;
        *"time="*)
            _pr="${1#*time=}"
            _pr="${_pr%% *}"
            ;;
        *) return 1 ;;
    esac
    case "$_pr" in ''|.*|*[!0-9.]*|*.*.*) return 1 ;; esac
    _pi="${_pr%%.*}"
    case "$_pr" in
        *.*) _pf="${_pr#*.}00" ;;
        *) _pf="00" ;;
    esac
    _pf="${_pf%"${_pf#??}"}"
    while :; do
        case "$_pi" in 0?*) _pi="${_pi#0}" ;; *) break ;; esac
    done
    [ "${#_pi}" -le 6 ] || return 1
    # Hundredths ("1$_pf - 100" keeps a leading-zero fraction out of octal), then
    # rounded to tenths.
    _pt=$(( _pi * 100 + 1$_pf - 100 ))
    _pt=$(( (_pt + 5) / 10 ))
    [ "$_pt" -gt 0 ] || return 1
    _RTT="$(( _pt / 10 )).$(( _pt % 10 ))"
}

# --- Address family from a ping banner ----------------------------------------
# _BF = ipv6 when the resolved address in "PING host (addr): 56 data bytes"
# holds a colon, else ipv4 (also when the banner is missing or odd).
_banner_family() {
    _BF="ipv4"
    case "$1" in
        *"PING "*" ("*"): "*)
            _bf="${1#*PING }"
            _bf="${_bf#*\(}"
            _bf="${_bf%%\)*}"
            case "$_bf" in *:*) _BF="ipv6" ;; esac
            ;;
    esac
}

# --- One leg ------------------------------------------------------------------
# probe_leg <target>: one echo request with a hard deadline; on success _RTT is
# the round trip and _FAM the family that answered (a literal's own family, a
# hostname's from the ping banner).
probe_leg() {
    _pl_out=""
    _RTT=""
    _FAM="none"
    _t_kind "$1"
    case "$_TK" in
        v6)
            [ -n "$PING6_CMD" ] || return 1
            # $PING6_CMD is an internal fixed token ("ping -6" / "ping6"): intended split.
            # shellcheck disable=SC2086
            _pl_out=$($PING6_CMD -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
            parse_rtt "$_pl_out" || return 1
            _FAM="ipv6"
            ;;
        host)
            _pl_out=$(plat_timeout "$HOST_DEADLINE" ping -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
            parse_rtt "$_pl_out" || return 1
            _banner_family "$_pl_out"
            _FAM="$_BF"
            ;;
        *)
            _pl_out=$(ping -c 1 -W "$PROBE_WAIT" -w "$PROBE_DEADLINE" "$1" 2>/dev/null </dev/null)
            parse_rtt "$_pl_out" || return 1
            _FAM="ipv4"
            ;;
    esac
    return 0
}

# Background body of one fan-out leg: leaves "ok <rtt> <family>" or "miss" in its
# result file (tmp + mv, so the poller never reads a half-written one).
leg_job() { # target file
    # Inherited traps would delete the daemon's PID file when this job exits.
    trap - EXIT INT TERM
    if probe_leg "$1"; then
        printf 'ok %s %s\n' "$_RTT" "$_FAM" > "$2.tmp"
    else
        printf 'miss\n' > "$2.tmp"
    fi
    mv -f "$2.tmp" "$2"
    exit 0
}

# True when the kernel holds a usable IPv6 default route (::/0 not on lo).
# Read with builtins only; this runs every cycle.
_ipv6_default_route() {
    [ -r "$IPV6_ROUTE" ] || return 1
    {
        while read -r _r_d _r_dl _r_s _r_sl _r_nh _r_m _r_rc _r_u _r_fl _r_dev; do
            [ "$_r_d" = "00000000000000000000000000000000" ] || continue
            [ "$_r_dl" = "00" ] || continue
            [ "$_r_dev" = "lo" ] && continue
            return 0
        done < "$IPV6_ROUTE"
    } 2>/dev/null
    return 1
}

# Kill the fan-out legs AND their children. A leg is leg_job -> (function
# subshell ->) timeout -> ping; signalling only the job leaves the probe running
# to its own deadline, so the descendants are collected from /proc first (ppid is
# field 4 of /proc/<pid>/stat; the comm of our own tree has no spaces) and
# everything is signalled at once. Reaps the jobs it started.
_fan_kill() {
    [ -n "$_fan_pids" ] || return 0
    _kt_all="$_fan_pids"
    _kt_new="$_fan_pids"
    while [ -n "$_kt_new" ]; do
        _kt_next=""
        for _kt_f in /proc/[0-9]*/stat; do
            _kt_pp=""
            { read -r _kt_pid _kt_comm _kt_st _kt_pp _kt_rest < "$_kt_f"; } 2>/dev/null || continue
            case "$_kt_pp" in ''|*[!0-9]*) continue ;; esac
            for _kt_p in $_kt_new; do
                if [ "$_kt_pp" = "$_kt_p" ]; then
                    _kt_next="$_kt_next $_kt_pid"
                    break
                fi
            done
        done
        _kt_all="$_kt_all $_kt_next"
        _kt_new="$_kt_next"
    done
    # shellcheck disable=SC2086
    kill $_kt_all 2>/dev/null
    # shellcheck disable=SC2086
    wait $_fan_pids 2>/dev/null
    _fan_pids=""
}

# _fan_read <slot>: _FR_ST = ok | miss | "" (still running), _FR_RTT, _FR_FAM.
_fan_read() {
    _FR_ST=""
    _FR_RTT=""
    _FR_FAM=""
    { read -r _FR_ST _FR_RTT _FR_FAM < "$FAN_DIR/r$1"; } 2>/dev/null
    case "$_FR_ST" in
        ok)
            case "$_FR_RTT" in ''|*[!0-9.]*) _FR_ST="miss" ;; esac
            case "$_FR_FAM" in ipv4|ipv6) ;; *) _FR_FAM="ipv4" ;; esac
            ;;
        miss) ;;
        *) _FR_ST="" ;;
    esac
}

# --- Fan-out over the remaining usable slots ---------------------------------
# _fan_run "<slots>": slots ascending. Sets _FW = the winning slot (0 = none)
# with _FW_RTT / _FW_FAM, and records every slot's state. Polls the result files
# every FAN_POLL s; the winner is the lowest-numbered slot that answered, decided
# once every lower slot has finished; the rest are killed. Hard stop one second
# past the hostname deadline, so a vanished leg cannot hang the cycle; at that
# stop the lowest slot that answered wins.
_fan_run() {
    _FW=0
    _FW_RTT=""
    _FW_FAM="none"

    if [ ! -d "$FAN_DIR" ]; then
        _sc_dir_ok
        mkdir -m 0700 "$FAN_DIR" 2>/dev/null
    fi
    if [ ! -d "$FAN_DIR" ]; then
        # No scratch dir (should not happen): one after another, lowest first.
        for _fs in $1; do
            _slot_target "$_fs"
            if probe_leg "$_ST"; then
                _slot_set "$_fs" ok "$_RTT"
                _FW="$_fs"; _FW_RTT="$_RTT"; _FW_FAM="$_FAM"
                return 0
            fi
            _slot_set "$_fs" miss ""
        done
        return 0
    fi

    rm -f "$FAN_DIR"/r? "$FAN_DIR"/r?.tmp 2>/dev/null
    _fan_pids=""
    for _fs in $1; do
        _slot_target "$_fs"
        leg_job "$_ST" "$FAN_DIR/r$_fs" </dev/null >/dev/null 2>&1 &
        _fan_pids="$_fan_pids $!"
    done

    _fhard=0
    _clock
    _fd=$(( _CS + (HOST_DEADLINE + 1) * 100 ))
    while :; do
        _fpend=0
        for _fs in $1; do
            _fan_read "$_fs"
            case "$_FR_ST" in
                ok) _FW="$_fs"; _FW_RTT="$_FR_RTT"; _FW_FAM="$_FR_FAM"; break ;;
                miss) ;;
                *) _fpend=1; break ;;
            esac
        done
        [ "$_FW" -ne 0 ] && break
        [ "$_fpend" -eq 0 ] && break
        _clock
        if [ "$_CS" -ge "$_fd" ]; then
            _fhard=1
            break
        fi
        sleep "$FAN_POLL"
    done
    _fan_kill

    # Hard stop with a lower slot still pending (a hung hostname lookup with no
    # timeout applet) and a higher one answered: take the lowest answered slot
    # rather than report an outage on a link that works.
    if [ "$_FW" -eq 0 ]; then
        for _fs in $1; do
            _fan_read "$_fs"
            if [ "$_FR_ST" = "ok" ]; then
                _FW="$_fs"; _FW_RTT="$_FR_RTT"; _FW_FAM="$_FR_FAM"
                break
            fi
        done
    fi

    # What each slot reported before it was cut off. A slot with no result was
    # killed for a lower slot's win ("standby"), or still silent at the hard stop
    # or with no winner ("miss").
    for _fs in $1; do
        _fan_read "$_fs"
        case "$_FR_ST" in
            ok) _slot_set "$_fs" ok "$_FR_RTT" ;;
            miss) _slot_set "$_fs" miss "" ;;
            *)
                if [ "$_FW" -ne 0 ] && [ "$_fhard" -eq 0 ]; then _slot_set "$_fs" standby ""; else _slot_set "$_fs" miss ""; fi
                ;;
        esac
    done
    return 0
}

# --- Probe one cycle ----------------------------------------------------------
# Sets PROBE_RTT, last_family, last_leg and the slot states; returns 0 when any
# slot answered. Globals, not stdout: a $( ) subshell would lose them.
PROBE_RTT=""
probe_cycle() {
    _slot_set 1 standby ""
    _slot_set 2 standby ""
    _slot_set 3 standby ""
    _slot_set 4 standby ""

    # Usable slots: an IPv6 literal needs a working ping -6 and a ::/0 route.
    _pc_v6=""
    _pc_use=""
    for _pc_s in 1 2 3 4; do
        _slot_target "$_pc_s"
        _t_kind "$_ST"
        if [ "$_TK" = "v6" ]; then
            if [ -z "$_pc_v6" ]; then
                _pc_v6=0
                [ -n "$PING6_CMD" ] && _ipv6_default_route && _pc_v6=1
            fi
            if [ "$_pc_v6" = "0" ]; then
                _slot_set "$_pc_s" skipped ""
                continue
            fi
        fi
        _pc_use="$_pc_use $_pc_s"
    done

    PROBE_RTT=""
    last_family="none"
    last_leg=0
    # shellcheck disable=SC2086
    set -- $_pc_use
    [ "$#" -gt 0 ] || return 1
    _pc_first="$1"
    shift

    _slot_target "$_pc_first"
    if probe_leg "$_ST"; then
        PROBE_RTT="$_RTT"; last_family="$_FAM"; last_leg="$_pc_first"
        _slot_set "$_pc_first" ok "$_RTT"
        return 0
    fi
    _slot_set "$_pc_first" miss ""
    [ "$#" -gt 0 ] || return 1

    _fan_run "$*"
    if [ "$_FW" -ne 0 ]; then
        PROBE_RTT="$_FW_RTT"; last_family="$_FW_FAM"; last_leg="$_FW"
        return 0
    fi
    return 1
}

# --- JSON string escape (builtins) -------------------------------------------
# _JS = $1 with \ and " backslash-escaped. Targets are charset-checked, so in
# practice only a hand-edited sensitivity name can carry either.
_json_str() {
    _js_in="$1"
    _JS=""
    while :; do
        case "$_js_in" in
            *[\\\"]*)
                _js_pre=${_js_in%%[\\\"]*}
                _js_in=${_js_in#"$_js_pre"}
                _js_c=${_js_in%"${_js_in#?}"}
                _js_in=${_js_in#?}
                _JS="${_JS}${_js_pre}\\${_js_c}"
                ;;
            *)
                _JS="${_JS}${_js_in}"
                break
                ;;
        esac
    done
}

# --- Write the JSON cache atomically -----------------------------------------
# Keys (contract 2, this order): timestamp, mono, sensitivity, targets[4],
# interval_sec, fail_secs, recover_secs, last_rtt_ms, reachable, streak_success,
# streak_fail, fail_elapsed_sec, during_recovery, last_family, last_leg,
# cycle_ms. A failed write keeps the previous file (readers would otherwise see
# an empty or partial one) and skips the sidecar and the slots file, which must
# never be newer than a JSON they do not match.
write_cache() {
    local rtt="$1"      # "34.2" or "null"
    local timestamp
    local during_recovery="false"
    local _jp

    timestamp=$(date +%s)
    case "$timestamp" in ''|*[!0-9]*) timestamp=0 ;; esac
    mono_now_set
    [ -f "$RECOVERY_FLAG" ] && during_recovery="true"
    case "$rtt" in ''|*[!0-9.]*) rtt="null" ;; esac

    _json_str "$PING_SENS"; _jp="$_JS"

    if printf '{"timestamp":%s,"mono":%s,"sensitivity":"%s","targets":["%s","%s","%s","%s"],"interval_sec":%s,"fail_secs":%s,"recover_secs":%s,"last_rtt_ms":%s,"reachable":%s,"streak_success":%s,"streak_fail":%s,"fail_elapsed_sec":%s,"during_recovery":%s,"last_family":"%s","last_leg":%s,"cycle_ms":%s}\n' \
            "$timestamp" "${_MONO:-0}" "$_jp" "$PING_T1" "$PING_T2" "$PING_T3" "$PING_T4" \
            "${PING_INTERVAL:-5}" "${PING_FAIL_SECS:-15}" "${PING_RECOVER_SECS:-10}" \
            "$rtt" "${reachable:-true}" "${streak_success:-0}" "${streak_fail:-0}" \
            "${fail_elapsed_sec:-0}" "$during_recovery" "${last_family:-none}" "${last_leg:-0}" \
            "${cycle_ms:-0}" > "$CACHE_TMP" 2>/dev/null \
        && [ -s "$CACHE_TMP" ] \
        && mv -f "$CACHE_TMP" "$CACHE_FILE" 2>/dev/null; then
        _wc_warned=0
        write_ping_env "$timestamp" "${_MONO:-0}" "$rtt" "$during_recovery"
        write_slots "${_MONO:-0}"
    else
        rm -f "$CACHE_TMP" 2>/dev/null
        if [ "${_wc_warned:-0}" = "0" ]; then
            qlog_warn "ping cache write failed, keeping the previous file"
            _wc_warned=1
        fi
    fi
    return 0
}

# write_slots <mono>: the per-slot outcome of the last cycle (contract 9A),
# printf, tmp + mv. Best effort, like the sidecar.
write_slots() {
    if printf '{"mono":%s,"slots":[{"state":"%s","rtt_ms":%s},{"state":"%s","rtt_ms":%s},{"state":"%s","rtt_ms":%s},{"state":"%s","rtt_ms":%s}]}\n' \
            "$1" "$SS1" "$SR1" "$SS2" "$SR2" "$SS3" "$SR3" "$SS4" "$SR4" > "$SLOTS_TMP" 2>/dev/null \
        && [ -s "$SLOTS_TMP" ] \
        && mv -f "$SLOTS_TMP" "$SLOTS_FILE" 2>/dev/null; then
        return 0
    fi
    rm -f "$SLOTS_TMP" 2>/dev/null
    return 1
}

# --- Sidecar helpers ---------------------------------------------------------
# _sc_sq <value>: _SCQ = value single-quoted for sh ('  ->  '\''). Empty -> '-'
# (the poller's "no value" token, same as conn_state_read's jq mapping).
_sc_sq() {
    _scq_in="${1:--}"
    _SCQ=""
    while :; do
        case "$_scq_in" in
            *\'*)
                _SCQ="${_SCQ}${_scq_in%%\'*}'\\''"
                _scq_in="${_scq_in#*\'}"
                ;;
            *)
                _SCQ="'${_SCQ}${_scq_in}'"
                break
                ;;
        esac
    done
}

# _sc_dir_ok: SC_DIR exists as a root-owned dir (re-created if the run dir was cleared).
_sc_dir_ok() {
    [ -d "$SC_DIR" ] && return 0
    if command -v qm_root_dir >/dev/null 2>&1; then
        qm_root_dir "$SC_DIR" 0700
    else
        mkdir -m 0700 "$SC_DIR" 2>/dev/null
    fi
}

# write_ping_env <timestamp> <mono> <rtt> <during_recovery>: the 16 raw fields
# conn_state_read extracts from ping.json (null/empty -> '-'), i.e. what
# conn_state_read_env sources. Best effort: a failure only means the poller
# falls back to reading ping.json.
write_ping_env() {
    _sc_dir_ok || return 1
    {
        _sc_sq "$1";                printf '_cq_ts=%s\n' "$_SCQ"
        _sc_sq "$2";                printf '_cq_mono=%s\n' "$_SCQ"
        _sc_sq "$reachable";        printf '_cq_reach=%s\n' "$_SCQ"
        case "$3" in null) _sc_sq "-" ;; *) _sc_sq "$3" ;; esac
        printf '_cq_rtt=%s\n' "$_SCQ"
        _sc_sq "$streak_success";   printf '_cq_ss=%s\n' "$_SCQ"
        _sc_sq "$streak_fail";      printf '_cq_sf=%s\n' "$_SCQ"
        _sc_sq "${fail_elapsed_sec:-0}"; printf '_cq_fe=%s\n' "$_SCQ"
        _sc_sq "$4";                printf '_cq_dr=%s\n' "$_SCQ"
        _sc_sq "$PING_INTERVAL";    printf '_cq_iv=%s\n' "$_SCQ"
        _sc_sq "$PING_FAIL_SECS";   printf '_cq_fs=%s\n' "$_SCQ"
        _sc_sq "$PING_RECOVER_SECS"; printf '_cq_rs=%s\n' "$_SCQ"
        _sc_sq "$PING_SENS";        printf '_cq_sens=%s\n' "$_SCQ"
        _sc_sq "$last_family";      printf '_cq_fam=%s\n' "$_SCQ"
        _sc_sq "$PING_T1";          printf '_cq_tgt=%s\n' "$_SCQ"
        _sc_sq "${last_leg:-0}";    printf '_cq_leg=%s\n' "$_SCQ"
        _sc_sq "${cycle_ms:-0}";    printf '_cq_cyc=%s\n' "$_SCQ"
        printf "qm_sidecar_end='1'\n"
    } 2>/dev/null > "${SC_PING}.new" \
        && mv -f "${SC_PING}.new" "$SC_PING" 2>/dev/null \
        || { rm -f "${SC_PING}.new" 2>/dev/null; return 1; }
    return 0
}

# write_dns_env <ok> <ms> <mono> <resolver>: the four fields the poller reads
# from dns.json (ms is "null" when the lookup failed).
write_dns_env() {
    _sc_dir_ok || return 1
    {
        _sc_sq "$1"; printf 'dns_s_ok=%s\n' "$_SCQ"
        _sc_sq "$2"; printf 'dns_s_ms=%s\n' "$_SCQ"
        _sc_sq "$3"; printf 'dns_s_mono=%s\n' "$_SCQ"
        _sc_sq "${4:-null}"; printf 'dns_s_res=%s\n' "$_SCQ"
        printf "qm_sidecar_end='1'\n"
    } 2>/dev/null > "${SC_DNS}.new" \
        && mv -f "${SC_DNS}.new" "$SC_DNS" 2>/dev/null \
        || { rm -f "${SC_DNS}.new" 2>/dev/null; return 1; }
    return 0
}

# =============================================================================
# DNS LOOKUP LATENCY (detached job — the probe loop's budget must not grow)
# =============================================================================
DNS_NAME="one.one.one.one"
DNS_FILE="${DNS_FILE:-/tmp/qmanager_dns.json}"
RESOLV_CONF="${RESOLV_CONF:-/etc/resolv.conf}"
DNS_INTERVAL=60          # seconds between scheduled lookups
DNS_MIN_GAP=10           # floor between lookups when an outage edge forces one
DNS_LOOKUP_TIMEOUT=5     # hard bound on the nslookup itself
DNS_JOB_MAX=15           # a job older than this is presumed gone (pid-reuse guard)
_dns_pid=""
_dns_started=""          # whole uptime seconds of the last spawn, "" = never
_dns_force=0             # 1 = lookup on the next free slot, interval or not
_dns_prev_reach=""
_dm=0

# The detached job: first nameserver in resolv.conf, re-read every run (it changes on reattach).
dns_job() {
    # Inherited traps would delete the daemon's PID file when this job exits.
    trap - EXIT INT TERM
    _res=$(awk '$1 == "nameserver" { print $2; exit }' "$RESOLV_CONF" 2>/dev/null)
    case "$_res" in *[!0-9A-Za-z:.%_-]*) _res="" ;; esac
    _ms="null"
    _ok="false"
    if [ -n "$_res" ]; then
        _out=$(mktemp /tmp/qmanager_dns_out.XXXXXX 2>/dev/null)
        if [ -n "$_out" ]; then
            _uptime_cs; _t0="$_CS"
            plat_timeout "$DNS_LOOKUP_TIMEOUT" nslookup "$DNS_NAME" "$_res" >"$_out" 2>&1 </dev/null
            _rc=$?
            _uptime_cs; _t1="$_CS"
            # Success = exit 0 and an Address line after a Name line (the server header has one too).
            if [ "$_rc" -eq 0 ] && awk '/^Name:/ { n = 1; next } n && /^Address/ { f = 1 } END { exit !f }' "$_out"; then
                _ok="true"
                _ms=$(( (_t1 - _t0) * 10 ))
                [ "$_ms" -lt 10 ] && _ms=10
            fi
            rm -f "$_out"
        fi
    fi

    _uptime_cs
    _tmp=$(mktemp "${DNS_FILE}.XXXXXX" 2>/dev/null) || exit 0
    if jq -n --argjson ms "$_ms" --argjson ok "$_ok" --arg res "$_res" --arg name "$DNS_NAME" \
            --argjson mono "$((_CS / 100))" --argjson ts "$(date +%s)" \
            '{ms: $ms, ok: $ok, resolver: $res, name: $name, mono: $mono, ts: $ts}' > "$_tmp" 2>/dev/null \
        && chmod 644 "$_tmp" && mv "$_tmp" "$DNS_FILE"; then
        write_dns_env "$_ok" "$_ms" "$((_CS / 100))" "$_res"
    else
        rm -f "$_tmp"
    fi
    exit 0
}

# True while the last spawned job runs. A reaped or zombie pid is free; so is one older than DNS_JOB_MAX.
_dns_busy() {
    [ -n "$_dns_pid" ] || return 1
    _dl=""
    { read -r _dl < "/proc/$_dns_pid/stat"; } 2>/dev/null
    case "$_dl" in
        ''|*") Z "*) _dns_pid=""; return 1 ;;
    esac
    if [ $((_dm - _dns_started)) -ge "$DNS_JOB_MAX" ]; then
        _dns_pid=""
        return 1
    fi
    return 0
}

# Once per cycle, after the verdict is written: spawns at most one detached job.
dns_probe_maybe() {
    _uptime_cs || return 0
    _dm=$((_CS / 100))
    # A true -> false edge forces a fresh lookup so an outage never shows an old good number.
    if [ "$_dns_prev_reach" = "true" ] && [ "$reachable" = "false" ]; then
        _dns_force=1
    fi
    _dns_prev_reach="$reachable"

    _due=0
    if [ -z "$_dns_started" ]; then
        _due=1
    elif [ "$_dns_force" -eq 1 ]; then
        [ $((_dm - _dns_started)) -ge "$DNS_MIN_GAP" ] && _due=1
    elif [ $((_dm - _dns_started)) -ge "$DNS_INTERVAL" ]; then
        _due=1
    fi
    [ "$_due" -eq 1 ] || return 0
    _dns_busy && return 0

    _dns_started="$_dm"
    _dns_force=0
    dns_job </dev/null >/dev/null 2>&1 &
    _dns_pid=$!
    return 0
}

# =============================================================================
# MAIN LOOP
# =============================================================================

# Fixed-rate sleep: what is left of the interval after this cycle, floored at
# SLEEP_FLOOR_CS, as a fractional "S.CC" argument (BusyBox sleep takes one).
_cycle_sleep() { # cycle start (cs)
    _clock
    _cs_left=$(( PING_INTERVAL * 100 - (_CS - $1) ))
    [ "$_cs_left" -lt "$SLEEP_FLOOR_CS" ] && _cs_left="$SLEEP_FLOOR_CS"
    _cs_frac=$(( _cs_left % 100 ))
    [ "$_cs_frac" -lt 10 ] && _cs_frac="0$_cs_frac"
    sleep "$(( _cs_left / 100 )).$_cs_frac"
}

_cleanup() {
    _fan_kill
    rm -f "$PID_FILE" "$CACHE_TMP" "$SLOTS_TMP" "${SC_PING}.new" "$ATTACH_FLAG" 2>/dev/null
    rm -rf "$FAN_DIR" 2>/dev/null
}

main() {
    local _cyc_start
    local _cyc_prev=""
    local _probe_end
    local _el
    local rtt
    local record
    local old_pid

    if [ -z "${QM_PLATFORM_CQWD_LOADED:-}" ]; then
        qlog_error "ping: platform adapter qm_platform_cqwd.sh missing, refusing to start"
        echo "qmanager_ping: missing /usr/lib/qmanager/qm_platform_cqwd.sh" >&2
        exit 1
    fi

    # Prevent duplicate instances
    if [ -f "$PID_FILE" ]; then
        old_pid=$(cat "$PID_FILE" 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
            qlog_error "Another ping daemon already running (PID $old_pid), exiting"
            exit 1
        fi
        rm -f "$PID_FILE"
    fi
    echo $$ > "$PID_FILE"

    # BusyBox ash runs an INT/TERM trap handler but does NOT exit afterward, so
    # the INT/TERM trap ends in an explicit `exit` (confirmed on device
    # 2026-06-26, docs/development/busybox-quirks.md). The fan-out jobs are
    # killed and their scratch dir removed on every path.
    trap '_cleanup' EXIT
    trap '_cleanup; exit 0' INT TERM

    load_config
    detect_ping6

    qlog_info "========================================"
    qlog_info "QManager Ping Daemon starting (PID $$)"
    qlog_info "Sensitivity: ${PING_SENS}, interval ${PING_INTERVAL}s, fail ${PING_FAIL_SECS}s, recover ${PING_RECOVER_SECS}s"
    qlog_info "Slots: 1=${PING_T1} 2=${PING_T2} 3=${PING_T3} 4=${PING_T4}"
    qlog_info "IPv6 probe: ${PING6_CMD:-unavailable}, history ${HISTORY_SIZE}, leg deadline ${PROBE_DEADLINE}s"
    qlog_info "========================================"

    # Clean up stale files from a previous run
    rm -f "$CACHE_TMP" "$SLOTS_TMP" /tmp/qmanager_dns_out.* "${DNS_FILE}".?????? "${SC_PING}.new" "${SC_DNS}.new"
    rm -rf "$FAN_DIR"
    _sc_dir_ok
    : > "$HISTORY_FILE"
    history_count=0
    mono_now_set
    attach_until=$((_MONO + ATTACH_GRACE_SECS))
    : > "$ATTACH_FLAG"
    _clock

    while true; do
        # Live reload: re-read the config within one cycle when the CGI drops the flag.
        if [ -f "$RELOAD_FLAG" ]; then
            load_config
            detect_ping6
            rm -f "$RELOAD_FLAG"
            qlog_info "Reloaded config: sensitivity=${PING_SENS} interval=${PING_INTERVAL}s fail=${PING_FAIL_SECS}s recover=${PING_RECOVER_SECS}s slots=${PING_T1},${PING_T2},${PING_T3},${PING_T4} ping6=${PING6_CMD:-none}"
        fi

        _clock
        _cyc_start="$_CS"
        if [ -n "$_cyc_prev" ]; then
            cycle_ms=$(( (_cyc_start - _cyc_prev) * 10 ))
        else
            cycle_ms=$(( PING_INTERVAL * 1000 ))
        fi
        _cyc_prev="$_cyc_start"

        record=1
        if probe_cycle; then
            rtt="$PROBE_RTT"
        else
            rtt=""
        fi
        _clock
        _probe_end="$_CS"

        if [ -n "$rtt" ]; then
            # --- A leg answered ---
            streak_success=$((streak_success + 1))
            streak_fail=0
            _fail_since=""
            fail_elapsed_sec=0
            [ -z "$_ok_since" ] && _ok_since="$_cyc_start"
            _el=$(( _probe_end - _ok_since ))

            qlog_debug "PING OK: slot=${last_leg} family=${last_family} rtt=${rtt}ms (streak_success=${streak_success})"

            if [ "$reachable" = "false" ] && [ "$_el" -ge $(( PING_RECOVER_SECS * 100 )) ]; then
                reachable="true"
                qlog_state_change "reachable" "false" "true"
            fi

            if [ -n "$attach_until" ]; then
                attach_until=""
                rm -f "$ATTACH_FLAG"
                qlog_info "First probe answered, attach warm-up over"
            fi

            echo "$rtt $last_leg" >> "$HISTORY_FILE"
        else
            # --- Every leg failed ---
            rtt="null"
            streak_fail=$((streak_fail + 1))
            streak_success=0
            _ok_since=""
            [ -z "$_fail_since" ] && _fail_since="$_cyc_start"
            _el=$(( _probe_end - _fail_since ))
            [ "$_el" -lt 0 ] && _el=0
            fail_elapsed_sec=$(( _el / 100 ))

            qlog_debug "PING FAIL: no leg answered (streak_fail=${streak_fail}, fail_elapsed=${fail_elapsed_sec}s)"

            if [ "$reachable" = "true" ] && [ "$_el" -ge $(( PING_FAIL_SECS * 100 )) ]; then
                reachable="false"
                qlog_state_change "reachable" "true" "false"
                qlog_warn "Internet unreachable after ${fail_elapsed_sec}s of continuous failure (${streak_fail} probes)"
            fi

            if [ -n "$attach_until" ]; then
                mono_now_set
                if [ "$_MONO" -lt "$attach_until" ]; then
                    record=0
                else
                    attach_until=""
                    rm -f "$ATTACH_FLAG"
                    qlog_warn "No probe answered within ${ATTACH_GRACE_SECS}s of start, recording failures"
                fi
            fi

            [ "$record" -eq 1 ] && echo "null -" >> "$HISTORY_FILE"
        fi

        # Trim the ring with the shell counter (no wc -l fork)
        if [ "$record" -eq 1 ]; then
            history_count=$((history_count + 1))
            if [ "$history_count" -gt $(( HISTORY_SIZE + 10 )) ]; then
                tail -n "$HISTORY_SIZE" "$HISTORY_FILE" > "${HISTORY_FILE}.tmp"
                mv "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
                history_count=$HISTORY_SIZE
            fi
        fi

        write_cache "$rtt"

        dns_probe_maybe

        _cycle_sleep "$_cyc_start"
    done
}

# Sourcing for tests: QM_PING_NO_MAIN=1 defines everything without running.
[ "${QM_PING_NO_MAIN:-0}" = "1" ] || main "$@"
