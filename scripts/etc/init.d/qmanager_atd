#!/bin/sh /etc/rc.common
# =============================================================================
# qmanager_atd — QManager AT broker (procd)
# =============================================================================
# Starts before the main qmanager service (poller) so the poller's first AT
# call already goes through the broker, and stops after it.
#
# On every start it also reconciles these boot-time states:
#   - /usr/bin/qcmd, qsms and qmi -> qmanager_atd (multicall clients)
#   - /www/qmlive -> /var/run/qmanager/live (live-signal static dir under the run dir; the frontend
#     install wipes /www/*)
#   - port-bridge on/off (quecmanager.ports.host_at); a firmware update can
#     re-enable the vendor service, so this re-applies the user's choice.
#
# With the daemon down, qcmd still works: the client falls back to running
# the exchange in-process.
#
# Install location: /etc/init.d/qmanager_atd
# =============================================================================

START=98
STOP=11
USE_PROCD=1

start_service() {
    [ -f /usr/lib/qmanager/at_engine.sh ] && . /usr/lib/qmanager/at_engine.sh
    command -v at_qcmd_link >/dev/null 2>&1 || return 0

    at_qcmd_link
    command -v at_qsms_link >/dev/null 2>&1 && at_qsms_link
    command -v at_qmi_link >/dev/null 2>&1 && at_qmi_link
    command -v at_live_link >/dev/null 2>&1 && at_live_link
    host_at_apply

    at_broker_available || return 0

    local log_level
    log_level=$(cat /etc/qmanager/log_level 2>/dev/null || echo "INFO")

    procd_open_instance "broker"
    procd_set_param command /usr/bin/qmanager_atd
    procd_set_param env QLOG_LEVEL="$log_level"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param respawn 3600 5 5
    procd_close_instance
}

stop_service() {
    # A stale socket is harmless (clients get ECONNREFUSED and fall back), but
    # remove it so status checks read true.
    rm -f /var/run/qmanager_atd.sock
    # Capability file (proto=N): written by the daemon after it binds. Removed
    # here so a rolled-back binary, which never writes it, is not credited
    # with a protocol it does not speak.
    rm -f /var/run/qmanager_atd.proto /var/run/qmanager_atd.proto.new
    # QMI sidecars + lease. The sourced env lives in the root-only run dir;
    # the json and the lease are in /tmp. Atomic-write temps are "<path>.new".
    rm -f /var/run/qmanager/qmi.env /var/run/qmanager/qmi.env.new \
        /tmp/qmanager_qmi.json /tmp/qmanager_qmi.json.new /tmp/qmanager_qmi_live
    # Live-signal channel: the /www link (removed so it never dangles; a real
    # directory there is not ours), the public dir, and any copy an earlier
    # build left in world-writable /tmp. Then the per-tier lease stamps (+ CGI
    # temps), the capability token and its lock.
    [ -L /www/qmlive ] && rm -f /www/qmlive
    rm -rf /var/run/qmanager/live /tmp/qmanager_live
    rm -f /var/run/qmanager/qmi_live_aim /var/run/qmanager/qmi_live_aim.* \
        /var/run/qmanager/qmi_live_watch /var/run/qmanager/qmi_live_watch.* \
        /var/run/qmanager/qmi_live.token /var/run/qmanager/qmi_live.token.* \
        /var/run/qmanager/qmi_live.lock
}

# No reload trigger on purpose: many CGIs commit the quecmanager config, and
# re-running this start path on each would be noise. The settings CGI
# (system/host_at_ports.sh) applies its change explicitly.
