#!/bin/sh /etc/rc.common
# ssr_watch: procd service for the SSR watcher (dev-only; never part of the
# QManager package). Installed to /etc/init.d/ssr_watch by
# tools/ssr-watch/ssrwatch_install.sh. The log, state and the rollback broker
# live on /usrdata/ssr_watch so a reboot resumes the count.
#
# Remove: /etc/init.d/ssr_watch stop; /etc/init.d/ssr_watch disable;
#         rm -f /etc/init.d/ssr_watch; rm -rf /usrdata/ssr_watch

START=99
STOP=05
USE_PROCD=1

DIR=/usrdata/ssr_watch

start_service() {
    [ -f "$DIR/bin/ssrwatch.sh" ] || return 0

    procd_open_instance watch
    procd_set_param command /bin/sh "$DIR/bin/ssrwatch.sh"
    # Respawn after 30 s, no retry limit: the daemon only exits on a fault.
    procd_set_param respawn 3600 30 0
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}
